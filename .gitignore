# Claude Code worktrees (directory-only pattern — keep the trailing slash)
.claude/worktrees/

# Swift / SPM
.build/
.swiftpm/
Package.resolved
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
