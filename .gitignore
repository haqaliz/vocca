# Claude Code worktrees (directory-only pattern — keep the trailing slash)
.claude/worktrees/

# Swift / SPM
.build/
.swiftpm/
Package.resolved
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/

# macOS
.DS_Store

# Host-local signing state (see Scripts/dev-identity.sh). Never checked in: this is what wires
# the checked-in Config/Signing.xcconfig to whichever identity exists on *this* machine, and a
# committed copy would either be wrong on someone else's machine or leak nothing useful and just
# rot.
Config/Signing.local.xcconfig

# Local model caches, recorded audio, and BYOK secrets never get committed.
# Local-first promise: this data stays on the box (see CLAUDE.md).
.env
.env.*
# The model-cache directory is at the repo root only. Anchored to the root because on a
# case-insensitive filesystem the bare pattern also matched Sources/VoccaASR/Models/ — the
# ARCHITECTURE.md:90-93 home of the manifest and store code, which must be committable.
/models/
recordings/
*.mlmodelc
*.gguf

# SDD scratch workspace (ledger, briefs, review packages)
.superpowers/

# Xcode per-user state, at any depth (the two patterns above miss the nested
# project.xcworkspace/xcuserdata/ that Xcode creates on first open).
**/xcuserdata/

# graphify knowledge-graph output — regenerable, large (graph.json alone is ~9 MB)
graphify-out/
